{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "frontend-local-api",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "VITE_PROXY_API_TARGET=http://localhost:8000 npm run dev"],
      "cwd": "frontend",
      "port": 5174,
      "autoPort": true
    }
  ]
}
